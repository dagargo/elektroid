  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="bend_ranges">
    <property name="lower">1</property>
    <property name="step-increment">1</property>
    <property name="upper">12</property>
    <property name="value">2</property>
  </object>
  <object class="GtkAssistant" id="calibration_assistant">
    <property name="modal">1</property>
    <property name="resizable">0</property>
    <property name="title" translatable="yes">Calibration assistant</property>
    <child internal-child="action_area">
      <object class="GtkBox">
        <property name="visible">0</property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="child">
          <object class="GtkLabel">
            <property name="label" translatable="yes">This procedure calibrates the pitch bend and modulation wheels.</property>
            <property name="wrap">1</property>
          </object>
        </property>
        <property name="complete">True</property>
        <property name="title" translatable="yes">Start</property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="child">
          <object class="GtkLabel">
            <property name="label" translatable="yes">Let the pitch bend wheel rest at the neutral position and click on the next button.</property>
            <property name="wrap">1</property>
          </object>
        </property>
        <property name="complete">True</property>
        <property name="page-type">intro</property>
        <property name="title" translatable="yes">Step 1</property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="child">
          <object class="GtkLabel">
            <property name="label" translatable="yes">While setting both wheels at the bottom click on the next button.</property>
            <property name="wrap">1</property>
          </object>
        </property>
        <property name="complete">True</property>
        <property name="page-type">intro</property>
        <property name="title" translatable="yes">Step 2</property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="child">
          <object class="GtkLabel">
            <property name="label" translatable="yes">While setting both wheels at the top click on the next button.</property>
            <property name="wrap">1</property>
          </object>
        </property>
        <property name="complete">True</property>
        <property name="page-type">intro</property>
        <property name="title" translatable="yes">Step 3</property>
      </object>
    </child>
    <child>
      <object class="GtkAssistantPage">
        <property name="child">
          <object class="GtkLabel">
            <property name="label" translatable="yes">Calibration completed</property>
            <property name="wrap">1</property>
          </object>
        </property>
        <property name="complete">True</property>
        <property name="page-type">summary</property>
        <property name="title" translatable="yes">End</property>
      </object>
    </child>
  </object>
